ARG JAVA_IMAGE=eclipse-temurin:25-jre
FROM ${JAVA_IMAGE} AS extract
WORKDIR /build
COPY target/data-jdbc-lab-1.0.0.jar app.jar
RUN java -Djarmode=tools -jar app.jar extract --layers --destination extracted

FROM ${JAVA_IMAGE}
WORKDIR /app
COPY --from=extract --chown=10001:10001 /build/extracted/dependencies/ ./
COPY --from=extract --chown=10001:10001 /build/extracted/spring-boot-loader/ ./
COPY --from=extract --chown=10001:10001 /build/extracted/snapshot-dependencies/ ./
COPY --from=extract --chown=10001:10001 /build/extracted/application/ ./
USER 10001:10001
ENV SERVER_ADDRESS=0.0.0.0
EXPOSE 8087
ENTRYPOINT ["java", "-jar", "/app/app.jar"]

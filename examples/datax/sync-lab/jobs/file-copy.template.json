{
  "job": {
    "setting": {
      "speed": {"channel": 1},
      "errorLimit": {"record": 0}
    },
    "content": [
      {
        "reader": {
          "name": "txtfilereader",
          "parameter": {
            "path": ["${input_file}"],
            "encoding": "UTF-8",
            "fieldDelimiter": ",",
            "skipHeader": true,
            "nullFormat": "\\N",
            "column": [
              {"index": 0, "type": "long"},
              {"index": 1, "type": "string"},
              {"index": 2, "type": "string"},
              {"index": 3, "type": "string"},
              {"index": 4, "type": "string"}
            ]
          }
        },
        "writer": {
          "name": "txtfilewriter",
          "parameter": {
            "path": "${output_dir}",
            "fileName": "orders",
            "writeMode": "nonConflict",
            "fileFormat": "csv",
            "fieldDelimiter": ",",
            "encoding": "UTF-8",
            "nullFormat": "\\N",
            "header": ["order_id", "customer_id", "amount", "status", "updated_at"]
          }
        }
      }
    ]
  }
}
